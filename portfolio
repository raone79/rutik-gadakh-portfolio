/* ===== Persistent interaction session ===== */
function getSavedEyeCalibration(){
  try{
    const raw=sessionStorage.getItem('rutikEyeCalibration');if(!raw)return null;
    const saved=JSON.parse(raw);if(!saved?.coeffs)return null;
    const sizeOK=Math.abs(saved.w-innerWidth)/Math.max(innerWidth,1)<.08&&Math.abs(saved.h-innerHeight)/Math.max(innerHeight,1)<.08;
    const fresh=Date.now()-(saved.ts||0)<1000*60*60*6;
    return sizeOK&&fresh?saved.coeffs:null;
  }catch(e){return null}
}
async function restoreInteractionSession(){
  let profile='balanced',saved='mouse';
  try{profile=localStorage.getItem('rutikEyeProfile')||'balanced';saved=localStorage.getItem('rutikPortfolioMode')||'mouse'}catch(e){}
  applyEyeProfile(profile,true);
  if(!['gesture','eye','voice'].includes(saved))return;
  // Do not interrupt a deliberately opened modal or an active mode.
  if($$('.modal.show').length||currentMode!=='mouse')return;
  if(saved==='gesture'){
    const ok=await ensureCamera();if(!ok)return;
    await initHands();setDockMode('gesture');toast('Gesture mode restored');return;
  }
  if(saved==='eye'){
    const ok=await ensureCamera();if(!ok)return;
    await initFaceMesh();const savedCal=getSavedEyeCalibration();
    if(savedCal){calCoeffs=savedCal;eyeCalibrated=true;calInProgress=false;eyeCX=innerWidth/2;eyeCY=innerHeight/2;setDockMode('eye');toast('Eye mode + calibration restored')}
    else{setDockMode('eye');startCalibration()}
    return;
  }
  if(saved==='voice'){
    // SpeechRecognition support differs by browser; try to resume quietly.
    const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
    if(!SR)return;
    try{await startVoice()}catch(e){setDockMode('mouse')}
  }
}

