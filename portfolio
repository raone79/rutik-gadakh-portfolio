<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Rutik Gadakh | Interactive Marketing Portfolio</title>
<meta name="description" content="Interactive digital marketing portfolio with gesture, eye and voice navigation experiments.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/js/all.min.js"></script>
<style>
:root{
  --bg:#07090d;
  --bg-2:#0b0f16;
  --surface:rgba(16,19,26,.78);
  --surface-strong:#10131a;
  --surface-soft:rgba(255,255,255,.045);
  --text:#f5f7fa;
  --muted:#97a3b2;
  --muted-2:#657181;
  --line:rgba(255,255,255,.10);
  --primary:#6c8cff;
  --cyan:#62d9ff;
  --warm:#ffb86b;
  --success:#62e5a8;
  --danger:#ff667c;
  --shadow:0 24px 80px rgba(0,0,0,.35);
  --radius:24px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif;overflow-x:hidden;min-height:100vh}
a{color:inherit}
button,input{font:inherit}
button{cursor:pointer}
::selection{background:rgba(108,140,255,.35);color:#fff}

/* ===== Core background ===== */
#scroll-progress{position:fixed;top:0;left:0;height:2px;width:0;background:linear-gradient(90deg,var(--primary),var(--cyan),var(--warm));z-index:20000}
#fx-canvas{position:fixed;inset:0;width:100%;height:100%;z-index:-3;background:radial-gradient(circle at center,#0d0e1b 0%,#050711 48%,#020307 100%)}
.bg-vignette{position:fixed;inset:0;z-index:-2;pointer-events:none;background:radial-gradient(circle at 50% 48%,transparent 30%,rgba(0,0,0,.13) 67%,rgba(0,0,0,.48) 100%)}
.bg-grid{display:none}

/* ===== Layout ===== */
.shell{width:min(1180px,calc(100% - 40px));margin:0 auto}
.site-header{position:sticky;top:0;z-index:7000;padding:14px 0;background:linear-gradient(to bottom,rgba(7,9,13,.9),rgba(7,9,13,.56),transparent);backdrop-filter:blur(14px)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:18px;border:1px solid var(--line);background:rgba(10,13,19,.68);border-radius:18px;padding:11px 14px 11px 18px;box-shadow:0 16px 50px rgba(0,0,0,.18)}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none}
.brand-mark{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;background:linear-gradient(135deg,var(--primary),var(--cyan));color:#071018;font-weight:900;font-family:Space Grotesk,sans-serif;box-shadow:0 0 28px rgba(98,217,255,.18)}
.brand-copy strong{font:600 14px/1 Space Grotesk,sans-serif;display:block;letter-spacing:.02em}.brand-copy span{font:500 9px/1 Orbitron,sans-serif;letter-spacing:.18em;color:var(--muted);display:block;margin-top:5px}
.nav-links{display:flex;align-items:center;gap:3px}.nav-links a{padding:9px 11px;text-decoration:none;color:var(--muted);font-size:13px;border-radius:10px;transition:.2s}.nav-links a:hover{color:#fff;background:rgba(255,255,255,.05)}
.interactive-pill{border:1px solid rgba(108,140,255,.35);background:rgba(108,140,255,.08);color:#dbe3ff;border-radius:12px;padding:9px 12px;font-size:12px;display:flex;align-items:center;gap:8px}.interactive-pill .dot{width:7px;height:7px;border-radius:50%;background:var(--success);box-shadow:0 0 12px var(--success)}

.hero{min-height:calc(100vh - 82px);display:grid;align-content:center;padding:74px 0 86px;position:relative}
.eyebrow{display:inline-flex;align-items:center;gap:8px;color:#c7d1de;font:600 10px/1 Orbitron,sans-serif;letter-spacing:.18em;text-transform:uppercase;border:1px solid var(--line);background:rgba(255,255,255,.03);padding:9px 11px;border-radius:999px;width:max-content;margin-bottom:22px}.eyebrow i{width:6px;height:6px;border-radius:50%;background:var(--warm)}
.hero h1{font:700 clamp(54px,8vw,112px)/.91 Space Grotesk,sans-serif;letter-spacing:-.055em;max-width:980px}.hero h1 .soft{color:#aab5c4}.hero h1 .accent{background:linear-gradient(90deg,#fff 0%,#cbd5ff 35%,var(--cyan) 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-lead{margin-top:28px;display:grid;grid-template-columns:minmax(0,620px) auto;gap:42px;align-items:end}.hero-copy{font-size:18px;line-height:1.7;color:#b5c0ce;max-width:650px}.hero-copy strong{color:#fff;font-weight:600}
.hero-actions{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}.btn{border-radius:13px;padding:13px 17px;font-weight:700;font-size:13px;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid transparent;transition:.22s}.btn-primary{background:#f5f7fa;color:#0a0d12}.btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 36px rgba(255,255,255,.14)}.btn-ghost{border-color:var(--line);background:rgba(255,255,255,.035);color:#eef2f7}.btn-ghost:hover{border-color:rgba(98,217,255,.35);background:rgba(98,217,255,.06)}
.hero-meta{margin-top:64px;display:flex;justify-content:space-between;align-items:flex-end;gap:24px}.hero-statbar{display:flex;gap:34px;flex-wrap:wrap}.hero-stat span{display:block}.hero-stat .n{font:600 28px/1 Space Grotesk,sans-serif}.hero-stat .l{color:var(--muted);font-size:11px;margin-top:6px;text-transform:uppercase;letter-spacing:.08em}.scroll-note{color:var(--muted-2);font:600 9px/1 Orbitron,sans-serif;letter-spacing:.18em;text-transform:uppercase;display:flex;align-items:center;gap:10px}.scroll-note:before{content:"";width:48px;height:1px;background:linear-gradient(90deg,var(--cyan),transparent)}

.section{padding:110px 0}.section-kicker{color:var(--cyan);font:600 10px/1 Orbitron,sans-serif;letter-spacing:.2em;text-transform:uppercase;margin-bottom:13px}.section-title{font:600 clamp(36px,5vw,68px)/1.02 Space Grotesk,sans-serif;letter-spacing:-.045em;max-width:800px}.section-copy{color:var(--muted);font-size:16px;line-height:1.8;max-width:660px;margin-top:20px}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:42px}.section-head .section-copy{margin:0;max-width:430px}

/* Impact */
.impact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.impact-card{position:relative;overflow:hidden;min-height:180px;border:1px solid var(--line);border-radius:20px;padding:23px;background:linear-gradient(145deg,rgba(255,255,255,.05),rgba(255,255,255,.018));backdrop-filter:blur(12px)}.impact-card:before{content:"";position:absolute;width:130px;height:130px;border-radius:50%;right:-45px;top:-55px;background:radial-gradient(circle,rgba(108,140,255,.19),transparent 67%)}.impact-card .num{font:600 42px/1 Space Grotesk,sans-serif;letter-spacing:-.04em}.impact-card .label{font-size:13px;color:#c3ccd8;margin-top:12px}.impact-card .micro{font-size:11px;line-height:1.5;color:var(--muted-2);margin-top:24px}

/* Case studies */
.work-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:16px}.case-card{min-height:380px;border:1px solid var(--line);border-radius:28px;padding:28px;background:linear-gradient(160deg,rgba(11,15,22,.96),rgba(7,10,16,.92));position:relative;overflow:hidden;box-shadow:var(--shadow);display:flex;flex-direction:column}.case-card.large{grid-row:span 2;min-height:776px}.case-card > :not(.case-art){position:relative;z-index:2}.case-card .case-id{font:600 9px/1 Orbitron,sans-serif;letter-spacing:.16em;color:var(--muted);text-transform:uppercase}.case-card h3{font:600 clamp(28px,4vw,50px)/1.05 Space Grotesk,sans-serif;letter-spacing:-.035em;margin-top:16px;max-width:620px}.case-card p{color:var(--muted);line-height:1.7;font-size:14px;margin-top:14px;max-width:620px}.case-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:22px}.tag{font-size:10px;color:#c7d2df;border:1px solid rgba(255,255,255,.09);padding:7px 9px;border-radius:999px;background:rgba(255,255,255,.03)}.case-art{position:relative;left:auto;right:auto;bottom:auto;margin-top:auto;border-radius:22px;border:1px solid rgba(255,255,255,.09);min-height:210px;height:210px;background:radial-gradient(circle at 75% 30%,rgba(98,217,255,.22),transparent 25%),radial-gradient(circle at 35% 65%,rgba(108,140,255,.18),transparent 35%),#090d14;overflow:hidden;flex-shrink:0}.case-art .metric{position:absolute;padding:14px 16px;border-radius:15px;border:1px solid rgba(255,255,255,.10);background:rgba(14,18,25,.82);backdrop-filter:blur(10px);font:600 11px/1.4 Space Grotesk,sans-serif}.m1{left:6%;top:10%}.m2{right:6%;top:30%}.m3{left:22%;bottom:11%}.case-card.large .case-art{margin-top:34px;min-height:320px;height:320px}.case-card.small h3{font-size:clamp(24px,3vw,34px);max-width:430px}.case-card.small .case-art{margin-top:24px;min-height:150px;height:150px}


/* Proof library */
.proof-subhead{font:600 9px/1 Orbitron,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#7f90a4;margin:24px 0 12px}.proof-toolbar{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:28px}.proof-note{color:var(--muted);font-size:13px;line-height:1.7;max-width:520px}.proof-featured{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:14px}.proof-feature{border:1px solid rgba(98,217,255,.16);border-radius:20px;padding:20px;background:linear-gradient(145deg,rgba(98,217,255,.055),rgba(255,255,255,.018));text-decoration:none;transition:.22s;min-height:140px;display:flex;flex-direction:column;justify-content:space-between}.proof-feature:hover{transform:translateY(-3px);border-color:rgba(98,217,255,.38);background:rgba(98,217,255,.07)}.proof-feature small{font:600 8px/1 Orbitron,sans-serif;letter-spacing:.16em;color:var(--cyan);text-transform:uppercase}.proof-feature strong{font:600 18px/1.2 Space Grotesk,sans-serif;margin-top:20px}.proof-feature span{color:var(--muted);font-size:11px;margin-top:8px}.proof-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.proof-link{border:1px solid var(--line);border-radius:15px;padding:14px 15px;text-decoration:none;background:rgba(255,255,255,.024);display:flex;align-items:center;justify-content:space-between;gap:10px;color:#d7e0ea;font-size:12px;transition:.2s}.proof-link:hover{border-color:rgba(108,140,255,.34);background:rgba(108,140,255,.055);transform:translateY(-2px)}.proof-link i{color:var(--cyan);font-size:10px}.case-link-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.case-link{display:inline-flex;align-items:center;gap:7px;text-decoration:none;color:#d9e8f2;border:1px solid rgba(98,217,255,.22);background:rgba(98,217,255,.045);padding:8px 10px;border-radius:10px;font-size:10px}.case-link:hover{border-color:rgba(98,217,255,.48);background:rgba(98,217,255,.09)}

/* Proof & archive — simplified */
.proof-clean-head{display:flex;justify-content:space-between;align-items:end;gap:36px;margin-bottom:30px}.proof-clean-copy{max-width:520px;color:var(--muted);font-size:14px;line-height:1.8}.proof-context{margin-top:14px;color:#7f8c9d;font-size:11px;line-height:1.6}.proof-context a{color:var(--cyan);text-decoration:none}.proof-primary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.proof-primary-card{border:1px solid var(--line);border-radius:22px;padding:22px;background:linear-gradient(155deg,rgba(14,18,26,.95),rgba(8,11,17,.9));min-height:230px;display:flex;flex-direction:column}.proof-primary-card .proof-type{font:600 8px/1 Orbitron,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:var(--cyan)}.proof-primary-card h3{font:600 24px/1.08 Space Grotesk,sans-serif;letter-spacing:-.035em;margin-top:14px}.proof-primary-card p{font-size:12px;line-height:1.7;color:var(--muted);margin-top:10px}.proof-primary-card .case-link-row{margin-top:auto;padding-top:18px}.archive-bar{margin-top:18px;border:1px solid rgba(255,255,255,.09);border-radius:20px;padding:18px 20px;background:rgba(255,255,255,.025);display:flex;justify-content:space-between;align-items:center;gap:20px}.archive-bar-copy strong{display:block;font:600 16px/1.2 Space Grotesk,sans-serif}.archive-bar-copy span{display:block;color:var(--muted);font-size:11px;line-height:1.6;margin-top:6px}.archive-toggle{border:1px solid rgba(108,140,255,.28);background:rgba(108,140,255,.08);color:#e5ebff;border-radius:12px;padding:10px 13px;font-size:11px;font-weight:700;display:inline-flex;align-items:center;gap:8px;white-space:nowrap}.archive-toggle i{transition:transform .25s}.archive-toggle[aria-expanded="true"] i{transform:rotate(180deg)}.archive-panel{display:none;margin-top:12px;border:1px solid rgba(255,255,255,.07);border-radius:20px;padding:14px;background:rgba(5,8,13,.52)}.archive-panel.open{display:block}.archive-intro{font-size:10px;color:#778598;line-height:1.6;padding:3px 3px 12px}.archive-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.archive-link{border:1px solid rgba(255,255,255,.08);border-radius:13px;padding:12px 13px;text-decoration:none;background:rgba(255,255,255,.02);display:flex;align-items:center;justify-content:space-between;gap:10px;color:#d0dae5;font-size:11px;transition:.2s}.archive-link:hover{background:rgba(98,217,255,.055);border-color:rgba(98,217,255,.26);transform:translateY(-1px)}.archive-link i{font-size:9px;color:#778fa7}.archive-count{font:600 9px/1 Orbitron,sans-serif;letter-spacing:.12em;color:#8190a3;text-transform:uppercase}
@media(max-width:980px){.proof-clean-head{display:block}.proof-clean-copy{margin-top:16px}.proof-primary-grid{grid-template-columns:1fr 1fr}.archive-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:680px){.proof-primary-grid,.archive-grid{grid-template-columns:1fr}.archive-bar{align-items:flex-start;flex-direction:column}.archive-toggle{width:100%;justify-content:center}}

/* Hands-free target feedback */
.handsfree-focus{outline:2px solid rgba(98,229,168,.72)!important;outline-offset:4px!important;box-shadow:0 0 0 5px rgba(98,229,168,.08),0 0 28px rgba(98,229,168,.16)!important}
#dwell-indicator{position:fixed;left:0;top:0;width:48px;height:48px;border-radius:50%;pointer-events:none;z-index:15002;transform:translate(-50%,-50%);display:none;background:conic-gradient(var(--success) 0deg,rgba(255,255,255,.08) 0deg);-webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 4px),#000 0);mask:radial-gradient(farthest-side,transparent calc(100% - 4px),#000 0)}

/* Case study preview — recruiter first */
.case-preview-btn{display:inline-flex;align-items:center;gap:7px;border:1px solid rgba(108,140,255,.28);background:rgba(108,140,255,.08);color:#e7ecff;padding:8px 10px;border-radius:10px;font-size:10px;font-weight:700;transition:.2s}.case-preview-btn:hover{border-color:rgba(98,217,255,.52);background:rgba(98,217,255,.09);transform:translateY(-1px)}
.case-modal-card{width:min(920px,100%)}.case-modal-hero{margin-top:18px;padding:20px 22px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,rgba(108,140,255,.08),rgba(98,217,255,.025));position:relative;overflow:hidden}.case-modal-hero:after{content:"";position:absolute;width:260px;height:260px;border-radius:50%;right:-120px;top:-150px;background:radial-gradient(circle,rgba(98,217,255,.18),transparent 68%);pointer-events:none}.case-modal-eyebrow{font:600 9px/1 Orbitron,sans-serif;letter-spacing:.17em;text-transform:uppercase;color:var(--cyan)}.case-modal-hero h3{font:600 clamp(28px,4.5vw,48px)/1.04 Space Grotesk,sans-serif;letter-spacing:-.04em;margin-top:11px;max-width:720px}.case-modal-summary{color:#b6c2d0;font-size:13px;line-height:1.7;margin-top:10px;max-width:760px}
.case-scan-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.case-scan{border:1px solid var(--line);border-radius:18px;padding:17px;background:rgba(255,255,255,.024);min-height:150px}.case-scan-head{display:flex;align-items:center;gap:9px;margin-bottom:11px}.case-step{width:25px;height:25px;border-radius:8px;display:grid;place-items:center;background:rgba(98,217,255,.09);border:1px solid rgba(98,217,255,.15);font:600 8px/1 Orbitron,sans-serif;color:var(--cyan)}.case-scan h4{font:600 10px/1 Orbitron,sans-serif;letter-spacing:.15em;text-transform:uppercase;color:#9ba9ba}.case-scan p{color:#c8d2dd;font-size:12px;line-height:1.7}.case-work-list{list-style:none;display:grid;gap:8px}.case-work-list li{display:flex;gap:8px;align-items:flex-start;color:#c8d2dd;font-size:11px;line-height:1.55}.case-work-list li:before{content:"•";color:var(--success);font-weight:800}
.case-impact-list{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.case-impact-item{border:1px solid rgba(98,217,255,.14);border-radius:13px;padding:12px;background:rgba(98,217,255,.035)}.case-impact-item strong{display:block;font:600 18px/1 Space Grotesk,sans-serif}.case-impact-item span{display:block;color:var(--muted);font-size:9px;line-height:1.4;margin-top:5px}.case-proof-copy{color:#c8d2dd;font-size:11px;line-height:1.65;margin-bottom:10px}.case-modal-actions{display:flex;gap:8px;flex-wrap:wrap}.case-tech-wrap{margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,.07)}.case-tech-label{font:600 8px/1 Orbitron,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#778496;margin-bottom:8px}.case-tech{display:flex;flex-wrap:wrap;gap:6px}.case-tech span{font-size:9px;color:#d0d9e4;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.022);border-radius:999px;padding:6px 8px}.case-note{font-size:9px;line-height:1.5;color:var(--muted-2);margin-top:10px}
@media(max-width:680px){.case-scan-grid{grid-template-columns:1fr}.case-impact-list{grid-template-columns:repeat(2,1fr)}.case-modal-hero{padding:17px}.case-scan{min-height:auto}}

/* Featured work (clean rebuild) */
.featured-work-head{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:20px}.featured-work-copy{color:var(--muted);font-size:15px;line-height:1.8;max-width:560px}.featured-work-note{border:1px solid rgba(98,217,255,.16);background:rgba(98,217,255,.05);border-radius:18px;padding:16px 18px;max-width:420px}.featured-work-note strong{display:block;font:600 11px/1 Orbitron,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:var(--cyan);margin-bottom:10px}.featured-work-note p{color:#c3cfdd;font-size:12px;line-height:1.7}.featured-work-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;margin-top:28px}.featured-card{border:1px solid var(--line);border-radius:24px;padding:24px;background:linear-gradient(160deg,rgba(13,17,25,.96),rgba(8,11,17,.92));box-shadow:var(--shadow)}.featured-card .card-eyebrow{font:600 9px/1 Orbitron,sans-serif;letter-spacing:.16em;color:var(--cyan);text-transform:uppercase}.featured-card h3{font:600 34px/1.05 Space Grotesk,sans-serif;letter-spacing:-.04em;margin-top:14px}.featured-card .card-purpose{color:#ced7e3;font-size:12px;line-height:1.7;margin-top:10px}.featured-card .card-purpose strong{color:#fff}.featured-list{list-style:none;display:grid;gap:10px;margin-top:18px}.featured-list li{display:flex;gap:10px;align-items:flex-start;color:var(--muted);font-size:12px;line-height:1.65}.featured-list li i{color:var(--success);margin-top:3px}.featured-metrics{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.featured-metric{border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03);padding:9px 10px;border-radius:12px;min-width:88px}.featured-metric strong{display:block;font:600 16px/1 Space Grotesk,sans-serif;color:#fff}.featured-metric span{display:block;color:var(--muted);font-size:9px;line-height:1.35;margin-top:6px}.featured-foot{margin-top:16px;padding-top:14px;border-top:1px solid rgba(255,255,255,.07)}.featured-foot p{color:#8fa0b4;font-size:11px;line-height:1.7}
@media(max-width:980px){.featured-work-head{display:block}.featured-work-note{margin-top:18px;max-width:none}}

/* Universe */
.universe-wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:28px;align-items:center}
.universe-stage{height:620px;border-radius:32px;border:1px solid var(--line);background:radial-gradient(circle at 50% 48%,rgba(98,217,255,.075),transparent 30%),rgba(5,7,13,.58);position:relative;overflow:hidden;box-shadow:inset 0 0 100px rgba(0,0,0,.38),0 30px 90px rgba(0,0,0,.22)}
#universe-canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.universe-hud{position:absolute;left:20px;right:20px;bottom:18px;display:flex;justify-content:space-between;align-items:center;gap:12px;pointer-events:none;font:600 8px/1 Orbitron,sans-serif;letter-spacing:.16em;color:#6f7c90;text-transform:uppercase}
.universe-hud span:first-child{color:var(--cyan)}
