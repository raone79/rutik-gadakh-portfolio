function voiceIntent(t){
  t=normalizeVoice(t);if(!t)return null;
  if(/\b(stop listening|stop voice|voice off|turn off voice)\b/.test(t))return {id:'stop',label:'Voice stopped',run:()=>stopVoice(true)};
  if(/\b(scroll down|go down|move down|page down|next section|next)\b/.test(t))return {id:'down',label:'Scroll down',run:()=>scrollBy({top:innerHeight*.72,behavior:'smooth'})};
  if(/\b(scroll up|go up|move up|page up|previous section|previous|back up)\b/.test(t))return {id:'up',label:'Scroll up',run:()=>scrollBy({top:-innerHeight*.72,behavior:'smooth'})};
  if(/\b(show archive|open archive|older projects|archived projects|client archive)\b/.test(t))return {id:'archive',label:'Opening project archive',run:()=>{goTo('#proof');toggleProjectArchive(true)}};
  if(/\b(proof|proof library|portfolio links|campaign data|evidence)\b/.test(t))return {id:'proof',label:'Opening proof library',run:()=>goTo('#proof')};
  if(/\b(doit|do it)\b/.test(t)&&/\b(case|project|work|study|preview)\b/.test(t))return {id:'case-doit',label:'Opening Doit case study',run:()=>openCaseStudy('doit')};
