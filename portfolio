  if(/\b(top|home|start|go home|go to top)\b/.test(t))return {id:'top',label:'Going to top',run:()=>goTo('#top')};
  return null;
}

function runVoiceIntent(t,isFinal=false){
  const intent=voiceIntent(t);if(!intent)return false;
  const now=Date.now();
  if(intent.id===lastVoiceAction&&now-lastVoiceAt<VOICE_DUPLICATE_MS)return true;
  lastVoiceAction=intent.id;lastVoiceAt=now;intent.run();
  if(intent.id!=='stop'){toast('🎙 '+intent.label);setVoiceState('Voice • listening')}else toast('Voice control stopped');
  return true;
}
function handleVoice(t){return runVoiceIntent(t,true)}

