/* ===== Voice control — optimized for speed + reliability ===== */
$('#start-voice').addEventListener('click',startVoice);$('#voice-cancel').addEventListener('click',()=>{hideModal('voice-modal');setDockMode('mouse')});

let voiceRestartTimer=null,voiceStarting=false,voicePermissionPrimed=false;
let lastVoiceAction='',lastVoiceAt=0,lastHeard='';
const VOICE_DUPLICATE_MS=900;

function setVoiceState(label){if(currentMode==='voice')$('#dock-state').textContent=label}
function normalizeVoice(t){return (t||'').toLowerCase().replace(/[^a-z0-9\s]/g,' ').replace(/\s+/g,' ').trim()}

async function primeVoiceMic(){
  if(voicePermissionPrimed)return true;
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia)return true;
  try{
    const stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});
    stream.getTracks().forEach(t=>t.stop());
    voicePermissionPrimed=true;
    return true;
  }catch(e){
    console.warn('Microphone prewarm failed',e);
    return false;
  }
}

function createRecognition(){
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR)return null;
  const r=new SR();
  r.lang='en-IN';
  r.continuous=true;
  r.interimResults=true;
  r.maxAlternatives=5;

  r.onstart=()=>{
    voiceStarting=false;voiceRunning=true;
    hideModal('voice-modal');
    if(currentMode!=='voice')setDockMode('voice');
    setVoiceState('Voice • listening');
    toast('🎙 Voice ready — speak now');
  };
  r.onspeechstart=()=>setVoiceState('Voice • hearing you');
  r.onspeechend=()=>setVoiceState('Voice • listening');

  r.onresult=e=>{
    for(let i=e.resultIndex;i<e.results.length;i++){
      const result=e.results[i];
      for(let a=0;a<Math.min(result.length,5);a++){
        const heard=normalizeVoice(result[a].transcript);
        if(!heard)continue;
        lastHeard=heard;
        setVoiceState('Heard: '+heard.slice(0,24));
        if(runVoiceIntent(heard,result.isFinal))break;
      }
    }
  };

  r.onerror=e=>{
    voiceStarting=false;
    console.warn('Speech recognition error:',e.error,e.message||'');
    if(e.error==='not-allowed'||e.error==='service-not-allowed'){
      voiceRunning=false;setVoiceState('Microphone blocked');toast('Microphone permission is blocked');return;
    }
    if(e.error==='audio-capture'){
      voiceRunning=false;setVoiceState('No microphone');toast('No working microphone detected');return;
    }
    if(e.error==='network')setVoiceState('Voice • reconnecting');
    else setVoiceState('Voice • listening');
  };

  r.onend=()=>{
    voiceStarting=false;
    if(voiceRunning&&currentMode==='voice')scheduleVoiceRestart(140);
  };
  return r;
}

function scheduleVoiceRestart(delay=140){
  clearTimeout(voiceRestartTimer);
  voiceRestartTimer=setTimeout(()=>{
    if(!voiceRunning||currentMode!=='voice')return;
    if(!recognition)recognition=createRecognition();
    if(!recognition)return;
    try{voiceStarting=true;recognition.start()}catch(e){voiceStarting=false;scheduleVoiceRestart(350)}
  },delay);
}

async function startVoice(){
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR){hideModal('voice-modal');toast('Voice recognition not supported in this browser');setDockMode('mouse');return}
  $('#start-voice').disabled=true;$('#start-voice').textContent='Starting…';
  await primeVoiceMic();
  if(recognition){try{recognition.onend=null;recognition.stop()}catch(e){}}
  recognition=createRecognition();voiceRunning=true;
  try{voiceStarting=true;recognition.start()}catch(e){voiceStarting=false;scheduleVoiceRestart(250)}
  setTimeout(()=>{$('#start-voice').disabled=false;$('#start-voice').textContent='Start Voice Control'},800);
}

function stopVoice(setMouse=true){
  voiceRunning=false;voiceStarting=false;clearTimeout(voiceRestartTimer);
  if(recognition){try{recognition.onend=null;recognition.stop()}catch(e){}}
  if(setMouse)setDockMode('mouse');
}
